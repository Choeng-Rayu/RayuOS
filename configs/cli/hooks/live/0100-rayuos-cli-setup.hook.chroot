#!/bin/bash
# RayuOS CLI Edition - Chroot Hook
# Runs inside the chroot during build

set -e

echo "=== RayuOS CLI Edition Setup ==="

# Set default locale
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
locale-gen
update-locale LANG=en_US.UTF-8

# Enable zram for compressed swap
cat > /etc/systemd/system/zram-setup.service << 'EOF'
[Unit]
Description=Setup zram swap
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rayuos-zram-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

# Create zram setup script
cat > /usr/local/bin/rayuos-zram-setup << 'EOF'
#!/bin/bash
# Setup zram compressed swap
ZRAM_SIZE=$(($(grep MemTotal /proc/meminfo | awk '{print $2}') / 2))
modprobe zram
echo ${ZRAM_SIZE}K > /sys/block/zram0/disksize
mkswap /dev/zram0
swapon -p 100 /dev/zram0
EOF
chmod +x /usr/local/bin/rayuos-zram-setup

systemctl enable zram-setup.service

# Disable unnecessary services
systemctl disable apt-daily.timer || true
systemctl disable apt-daily-upgrade.timer || true
systemctl disable man-db.timer || true

# Set hostname
echo "rayuos" > /etc/hostname

# Create default user (will be configured at first boot)
useradd -m -s /bin/bash -G sudo,audio,video,netdev,plugdev rayu || true
echo "rayu:rayu" | chpasswd

# Enable NetworkManager
systemctl enable NetworkManager

echo "=== RayuOS CLI Edition Setup Complete ==="
